# ---------------------------------------------------------------------------
# Ayslock configuration. With NOTHING set, the app runs in labeled local demo
# mode: an embedded database file in .data/, simulated sign-in, emails previewed.
# ---------------------------------------------------------------------------

# Public base URL, used in emails, share links and QR codes.
APP_URL=http://localhost:3000

# Postgres connection string (Supabase: Project Settings > Database > Connection
# string, "Session pooler" or direct). Server-side only.
# On Vercel, Storage → Neon sets POSTGRES_URL automatically; either name works.
DATABASE_URL=

# Supabase Auth for provider sign-up/sign-in. Without these, sign-in is simulated.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Signs manage links and private access links. Recommended in production (32+ chars);
# if unset, a key is derived from the database URL. Generate one with:
#   openssl rand -hex 32
APP_SECRET=

# Email delivery through Resend (https://resend.com). Without these, emails are
# only shown at /demo/outbox (local demo) and stay queued otherwise.
RESEND_API_KEY=
EMAIL_FROM="Ayslock <bookings@your-domain.com>"

# Protects /api/cron/notifications. Your scheduler sends: Authorization: Bearer $CRON_SECRET
CRON_SECRET=

# Local demo database location (only used when DATABASE_URL is empty).
# PGLITE_DIR=.data/pglite
